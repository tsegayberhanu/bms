generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  name     String
  password String
  role     Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens     RefreshToken[]
  billsCreated      Bill[]         @relation("BillerBills")
  billsAssigned     Bill[]         @relation("CustomerBills")
  paymentsMade      Payment[]      @relation("CustomerPayments")
  remindersReceived Reminder[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String
  revoked   Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([token])
}

model Bill {
  id          String          @id @default(uuid())
  title       String
  description String?
  amount      Decimal         @db.Decimal(10, 2)
  dueDate     DateTime
  status      BillStatus      @default(PENDING)
  paymentMode BillPaymentMode @default(ALLOW_PARTIAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billerId String
  biller   User   @relation("BillerBills", fields: [billerId], references: [id])

  customerId String
  customer   User   @relation("CustomerBills", fields: [customerId], references: [id])

  payments  Payment[]
  reminders Reminder[]

  @@index([billerId])
  @@index([customerId])
  @@index([BillStatus])

}

model Payment {
  id             String  @id @default(uuid())
  transactionKey String  @unique
  amount         Decimal @db.Decimal(10, 2)
  note           String? @db.Text

  createdAt DateTime @default(now())

  billId String
  bill   Bill   @relation(fields: [billId], references: [id])

  customerId String
  customer   User   @relation("CustomerPayments", fields: [customerId], references: [id])

  @@index([billId])
  @@index([customerId])
}

model Reminder {
  id     String         @id @default(uuid())
  type   ReminderType
  status ReminderStatus @default(PENDING)

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  billId String
  bill   Bill   @relation(fields: [billId], references: [id])

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

   @@index([ReminderType])
}

enum Role {
  ADMIN
  BILLER
  CUSTOMER
}

enum ReminderType {
  ASSIGNED
  UPCOMING
  DUE
  OVERDUE
}

enum BillPaymentMode {
  FULL_ONLY
  ALLOW_PARTIAL
}

enum BillStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}
